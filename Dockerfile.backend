FROM python:3.12-slim

WORKDIR /app

# 安装依赖 + curl（健康检查用）
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# 复制后端代码
COPY backend/ ./backend/

# 创建运行时目录 + 非 root 运行用户
# 注意：compose 若把宿主目录 bind-mount 进来，Linux 宿主需保证 uid 1000 可写
RUN mkdir -p data/history config logs \
    && useradd -r -u 1000 -M appuser \
    && chown -R appuser:appuser /app

USER appuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:8000/health || exit 1

EXPOSE 8000

CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
