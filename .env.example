# 热搜监控配置示例
# 复制此文件为 .env 并填写配置

# 运行模式
DEBUG=false

# 本应用 API 认证密钥（强烈建议公网部署时设置；设置后需在网页
# 「设置 → 关于 → API 访问密钥」填入相同值）
API_KEY=

# UApiPro 热搜数据源 API Key（留空则使用免费额度，多个 Key 逗号分隔自动轮换）
UAPI_API_KEY=

# CORS允许的来源（逗号分隔）
CORS_ORIGINS=

# 历史快照
HISTORY_ENABLED=true
HISTORY_RETENTION_DAYS=7
# 快照数量上限（每个约 0.6MB，1000 个 ≈ 600MB 磁盘）
MAX_HISTORY_SNAPSHOTS=1000

# Docker端口映射（后端仅绑定 127.0.0.1，公网请走前端 nginx 容器）
BACKEND_PORT=8000
FRONTEND_PORT=80
