# 热搜监控配置示例
# 复制此文件为 .env 并填写配置

# 运行模式
DEBUG=false

# API认证密钥（留空则不启用认证）
API_KEY=

# CORS允许的来源（逗号分隔）
CORS_ORIGINS=

# SMTP邮件配置
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USER=your_email@163.com
SMTP_PASSWORD=your_authorization_code
MAIL_FROM=your_email@163.com

# 历史快照
HISTORY_ENABLED=true
HISTORY_RETENTION_DAYS=7

# Docker端口映射
BACKEND_PORT=8000
FRONTEND_PORT=80
